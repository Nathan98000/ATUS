{
  "name": "atus-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "npm run types && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.2",
    "@types/node": "26.6.6",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
