{
  "name": "atus-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "npm run types && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@types/node": "24.19.1",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
