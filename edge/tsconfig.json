{
  // Worker code and the tests that run inside workerd. Runtime and Env types
  // come from `wrangler types` (worker-configuration.d.ts, generated by
  // `npm run types`; not committed).
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/vitest-plugin/types"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src",
    "test/worker",
    "test/fixtures.ts",
    "test/provided-context.d.ts"
  ]
}
