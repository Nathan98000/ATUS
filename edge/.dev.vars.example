# Local `wrangler dev` only: copy to .dev.vars (gitignored). These are
# development placeholders, not secrets; production values come from
# scripts/ops/gen_edge_secrets.sh and live only in the Worker's secret store.
EDGE_AUTH_SECRET=dev-only-edge-secret-change-me
# A local API started with ATUS_EDGE_SECRETS=dev-only-edge-secret-change-me
RENDER_ORIGIN=http://127.0.0.1:8571
OPS_TOKEN=dev-only-ops-token
IP_HMAC_KEY=dev-only-ip-hmac-key
