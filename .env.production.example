# Production configuration reference (ADR-011; docs/deployment.md,
# "Configuration reference"). Never put a real value in this file: real
# secrets live only in provider secret stores (Render environment, Worker
# secrets, GitHub environment secrets) and in the owner's private files under
# ~/.config/atus/ (chmod 600, outside the repository).
#
# Where each setting lives:
#   [render]  Render web service -> Environment (the API container)
#   [image]   baked into the image (Dockerfile); do not set on Render
#   [worker]  Cloudflare Worker var (edge/wrangler.jsonc or `wrangler deploy --var`)
#   [secret]  Cloudflare Worker secret (`npx wrangler secret put NAME`)
#   [github]  GitHub environment secret or variable (`production` or `ops`)
#
# Section 1 is the API's own configuration, in env-file form with its
# production values: an empty value means "set it on Render" for the required
# ones and "leave unset" for the rest. Everything else is reference only and
# commented out, so this file can never configure the wrong component.

# =============================================================================
# 1. API (Render web service)
# =============================================================================

# [render] required. `production` makes the API refuse to start unless
# ATUS_DATABASE_URL and ATUS_EDGE_SECRETS are set, and switches to JSON logs
# with /docs, /redoc and /openapi.json off. The image already defaults to it.
ATUS_ENV=production

# [render] required, secret. The `atus_api` (SELECT-only) DSN on Neon's
# DIRECT endpoint (never the -pooler host), written by the restore script to
# the project's ~/.config/atus/neon-<release>-<build8>.env (--secrets-file):
#   postgresql://atus_api:<password>@ep-<id>.us-east-1.aws.neon.tech:5432/atus?sslmode=verify-full&sslrootcert=system
# sslrootcert=system needs libpq >= 16 (the image bundles 18.x) and uses the
# image's CA bundle through SSL_CERT_FILE. Rotate: new password in the restore
# script's role step, update here, "Save and deploy". Production refuses a URL
# without sslmode=verify-full: `require` alone does not stop the API from
# starting against an impostor, and verify-ca never checks the host name.
ATUS_DATABASE_URL=

# [never on Render] The escape hatch for the local production-mode stack,
# whose Postgres has no TLS (docker-compose.prod.yml sets it): `local-stack-only`
# lifts the sslmode rule above, and is itself refused unless every host in
# ATUS_DATABASE_URL is on the local stack (a compose service name without
# dots, localhost or a loopback address, host.docker.internal, a Unix socket).
# Unset means `verify`.
# ATUS_DATABASE_TLS=

# [render] required, secret. Comma-separated accepted values of the
# X-ATUS-Edge-Auth header: "current" or, while rotating, "current,next". The
# current value equals the Worker secret EDGE_AUTH_SECRET. Rotate: set
# "old,new" here, deploy; put "new" in the Worker; deploy; set "new" here.
ATUS_EDGE_SECRETS=

# [render] Expected data version (ADR-011 release switch). A mismatch with the
# database answers 503 data_version_mismatch. Set it with ATUS_DATABASE_URL at
# every release switch. Empty: no check (development only). Format:
#   <release>:serving-<UTC YYYYMMDDTHHMMSSZ>-<8 hex>:<12 hex content hash>
#   e.g. 0325:serving-20261020T120000Z-1a2b3c4d:0123456789ab
ATUS_EXPECTED_DATA_VERSION=

# [render] secret. Bearer token for /metrics and /ready; empty makes both 404.
# Generated by scripts/ops/gen_edge_secrets.sh into ~/.config/atus/edge.env.
# Render only: no GitHub workflow calls the origin's /ready or /metrics. Not
# the Worker's OPS_TOKEN, which guards /api/_ops/budget.
ATUS_OPS_TOKEN=

# [render] One uvicorn process (ADR-011 process model). Also baked into the image.
WEB_CONCURRENCY=1

# [image] Set by Render (10000); `atus api` listens on it. Default 10000 in the image.
# PORT=10000

# [image] The git commit the image was built from (Dockerfile build arg),
# reported by /health as `build`. Default `dev`.
# ATUS_BUILD_SHA=dev

# --- optional tuning: production defaults, leave unset unless a measurement says otherwise
ATUS_LOG_LEVEL=INFO
# text (development) or json (production default)
ATUS_LOG_FORMAT=json
# on (development) or off (production default): /docs, /redoc, /openapi.json
ATUS_API_DOCS=off
# Allowed CORS origins, comma-separated. Empty: same origin behind the Worker.
ATUS_API_CORS_ORIGINS=
# Analysis-result LRU entries (in-process; lost on every spin-down).
ATUS_API_CACHE_SIZE=256
# psycopg pool: at most 4 connections (Neon allows 839 at the 0.25-2 CU compute;
# 104 if fixed at 0.25 CU). Must exceed ATUS_API_MAX_INFLIGHT (the API refuses
# to start otherwise), so metadata reads always find a connection while every
# lane computes.
ATUS_API_POOL_MAX_SIZE=4
# psycopg_pool closes at most one idle connection per 240 s period, so idle
# connections can outlive Neon's 300 s suspend; the first request after a wake
# closes the dead ones and opens at most two (ADR-012 "Pool").
ATUS_API_POOL_MAX_IDLE_S=240
# Pool acquire timeout in seconds -> 503 overloaded.
ATUS_API_POOL_TIMEOUT_S=5
# libpq connect_timeout in seconds (covers a Neon wake).
ATUS_API_CONNECT_TIMEOUT_S=10
# Per-request SET LOCAL statement_timeout for analyses (ms). Calibrated on the
# emulation profile (ADR-012 "Calibration"): clamp(3 x p99, 30 s, 85 s)
# gives 85 s at Neon's 0.25 CU floor, where the F66 compare takes up to 71 s.
# The request deadline is this plus 5 s; the atus_api role default (roles.sql)
# and the Worker's PROVISIONAL_BUSY_MS are sized for this value.
ATUS_API_STATEMENT_TIMEOUT_MS=85000
# The same for metadata and lexicon reads (ms).
ATUS_API_META_STATEMENT_TIMEOUT_MS=10000
# Per-request SET LOCAL jit (Neon has no LLVM; audit F37).
ATUS_API_JIT=off
# Per-request SET LOCAL max_parallel_workers_per_gather. Unset in production:
# the server's default. The emulation load tests found 0 faster at 0.25 CU and
# slower at 2 CU (ADR-012 "Calibration"); use 0 only if the compute is
# fixed at 0.25 CU, after its statistical-equivalence proof (brief section 9).
# ATUS_API_MAX_PARALLEL_WORKERS=
# Uncached analyses in flight, of which heavy (8 or more year queries:
# len(years), doubled for a compare). Calibrated (ADR-012 "Calibration").
ATUS_API_MAX_INFLIGHT=2
ATUS_API_MAX_INFLIGHT_HEAVY=1
# Seconds to wait for a lane before 503 overloaded. Calibrated (ADR-012).
ATUS_API_ADMISSION_WAIT_S=5
# Per-client-IP token buckets, "<tokens>/<seconds>": uncached analyses, and
# every request except /health (an analysis spends from both).
ATUS_API_RATE_ANALYSIS=6/60
ATUS_API_RATE_REQUESTS=120/60
# In-process daily backstop on uncached analyses (resets 00:00 UTC); the
# Worker's governor is the primary cap.
ATUS_API_DAILY_ANALYSIS_CAP=600
# Request body cap in bytes -> 413 payload_too_large.
ATUS_API_MAX_BODY_BYTES=65536
# anyio worker-thread limit.
ATUS_API_THREADS=16
# Refresh interval (s) of the in-process data_version/years/lexicon snapshot.
ATUS_API_SNAPSHOT_TTL_S=600
# psycopg auto-prepare threshold; `none` disables server-side prepared
# statements (needed only behind a transaction pooler without protocol-level
# prepared statements; production uses Neon's direct endpoint).
# ATUS_API_PREPARE_THRESHOLD=5

# --- pipeline only: never read by the API; for `atus load` and friends on the
# owner's machine (see .env.example)
# ATUS_DATA_DIR=data
# ATUS_RELEASE=0325
# ATUS_MIGRATIONS_DIR=        migrations directory when not running from a checkout

# --- serving-DB release tooling on the owner's machine only (ADR-013); never on
# Render. The owner DSN and the generated API credentials live in one gitignored
# file per Neon project, ~/.config/atus/neon-<release>-<build8>.env (chmod 600;
# --secrets-file), never in the repository.
# ATUS_SERVING_DATABASE_URL=  target of `atus build-serving-db`; serving side of `atus compare-serving-db`
#                             (`atus verify-serving-db` reads ATUS_DATABASE_URL or --database-url)
# ATUS_OWNER_DATABASE_URL=    neondb_owner direct DSN read by `atus restore-serving-db`
# ATUS_API_DB_PASSWORD=       written back by the restore: generated atus_api password
# ATUS_API_DATABASE_URL=      written back by the restore: the DSN to put on Render
# ATUS_API_ROLE_PASSWORD=     passed to psql only while applying scripts/ops/roles.sql
# ATUS_PG_CLIENT_IMAGE=       postgres image for pg_dump/pg_restore/psql when no local client

# =============================================================================
# 2. Cloudflare Worker secrets [secret] (`npx wrangler secret put NAME`)
#    Generated by scripts/ops/gen_edge_secrets.sh into ~/.config/atus/edge.env
# =============================================================================
# EDGE_AUTH_SECRET=   sent upstream as X-ATUS-Edge-Auth; one of ATUS_EDGE_SECRETS
# OPS_TOKEN=          bearer for GET /api/_ops/budget (answered by the Worker)
# IP_HMAC_KEY=        key for HMAC(daily key, client IP /24 or /48) in the governor
# RENDER_ORIGIN=      https://<service>.onrender.com (never published)
# NEON_API_KEY=       optional; Neon PROJECT-scoped key for the governor's usage poll

# =============================================================================
# 3. Cloudflare Worker vars [worker] (edge/wrangler.jsonc; deploy.yml sets the
#    data-dependent ones at every deploy)
# =============================================================================
# DATA_VERSION=       the release's data_version; gates KV stores and the cache scope
# ANALYTICS_VERSION=  engine version (from /api/v1/meta); part of the cache scope
# RESPONSE_FORMAT=1   must equal the API's X-Response-Format; part of the cache scope
# SNAPSHOT_ID=        <api_build12>-<sha256(DATA_VERSION)[:16]>; /snap/<id>/ directory
# EPOCH=              manual cache-scope bump that orphans every KV entry
# PREWAKE=on          `off` disables GET /api/v1/wake
# NEON_PROJECT_ID=    optional; the project the governor polls
# No var selects the API origin: the Worker reads it only from the secret
# RENDER_ORIGIN. The Vercel fallback (ADR-011 "Fallback") is a documented
# manual procedure whose preconditions are not implemented.

# =============================================================================
# 4. GitHub [github] (Settings -> Secrets and variables -> Actions, and
#    Settings -> Environments); the names .github/workflows/ reads
# =============================================================================
# repository variable:
#   PUBLIC_BASE_URL          https://<worker>.<account-subdomain>.workers.dev
#                            (deploy.yml and the monitors; monitors skip while unset)
# production environment (required reviewer), secrets:
#   CLOUDFLARE_API_TOKEN     Workers Editor on the one Worker, 90-day TTL
#   CLOUDFLARE_ACCOUNT_ID
#   RENDER_DEPLOY_HOOK_URL   Render -> Settings -> Deploy Hook (regenerate if leaked)
#   RENDER_ORIGIN            https://<service>.onrender.com
#   EDGE_OPS_TOKEN           optional here: the smoke then reads /api/_ops/budget
# ops environment (daily quota report), secret:
#   EDGE_OPS_TOKEN           the Worker's OPS_TOKEN (/api/_ops/budget)
# Not GitHub settings: ATUS_OPS_TOKEN (no workflow calls the origin's /ready or
# /metrics) and GHCR_IMAGE (the workflows name ghcr.io/nathan98000/atus-api).
# Rotation of every secret: docs/deployment.md, "Configuration reference".
