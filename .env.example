# Copy this file to `.env` and adjust as needed. All variables have working
# defaults for local development with the docker-compose PostgreSQL instance.
# `.env` and every other `.env.*` file except the committed examples are
# gitignored. Production settings: .env.production.example.

# development (default) or production. Production refuses to start without
# ATUS_DATABASE_URL and ATUS_EDGE_SECRETS and never falls back to the URL below.
ATUS_ENV=development

# PostgreSQL connection string (any libpq-style URL works).
# The docker-compose instance publishes on host port 5434 so it never collides
# with a PostgreSQL already running on the default 5432.
ATUS_DATABASE_URL=postgresql://atus:atus@localhost:5434/atus

# Where downloaded/staged data lives (relative paths are resolved against the repo root)
ATUS_DATA_DIR=data

# BLS multi-year release identifier (suffix of the multi-year files, e.g. 0325 = 2003-2025)
ATUS_RELEASE=0325

# Logging level for the pipeline CLI (DEBUG, INFO, WARNING, ERROR)
ATUS_LOG_LEVEL=INFO

# --- Phase 3 API ------------------------------------------------------------
# Allowed frontend origins for CORS, comma-separated. Empty (default) means
# no cross-origin access. For local ATUS Explorer development (Vite dev
# server), allow its origin:
# ATUS_API_CORS_ORIGINS=http://localhost:5173
ATUS_API_CORS_ORIGINS=

# Analysis-result cache entries (in-process LRU)
ATUS_API_CACHE_SIZE=256

# --- Phase 5 API (optional in development) ------------------------------------
# Every other API setting (edge secret, ops token, timeouts, rate limits,
# concurrency lanes) is listed with its default in .env.production.example.
# Development defaults: no edge authentication, text logs, /docs on.
# `atus api` listens on PORT (default 8000).
# ATUS_EDGE_SECRETS=
# ATUS_LOG_FORMAT=text
# ATUS_API_DOCS=on
# PORT=8000

# --- Tests -------------------------------------------------------------------
# Integration tests and the E2E backend use their own disposable databases:
# ATUS_TEST_DATABASE_URL=postgresql://atus:atus@localhost:5434/atus_test
# ATUS_E2E_DATABASE_URL=postgresql://atus:atus@localhost:5434/atus_e2e
# (scripts/e2e_backend.py drops schema `atus` there, so it only accepts a local
# database named atus_e2e or atus_e2e_<suffix>.)
