# Copy this file to `.env` and adjust as needed. All variables have working
# defaults for local development with the docker-compose PostgreSQL instance.

# PostgreSQL connection string (any libpq-style URL works).
# The docker-compose instance publishes on host port 5434 so it never collides
# with a PostgreSQL already running on the default 5432.
ATUS_DATABASE_URL=postgresql://atus:atus@localhost:5434/atus

# Where downloaded/staged data lives (relative paths are resolved against the repo root)
ATUS_DATA_DIR=data

# BLS multi-year release identifier (suffix of the multi-year files, e.g. 0325 = 2003-2025)
ATUS_RELEASE=0325

# Logging level for the pipeline CLI (DEBUG, INFO, WARNING, ERROR)
ATUS_LOG_LEVEL=INFO
