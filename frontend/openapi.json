{
 "openapi": "3.1.0",
 "info": {
  "title": "ATUS Analysis API",
  "description": "Read-only analytical API over the American Time Use Survey (ATUS) 2003-2025\nmulti-year microdata.\n\nAll estimates are **survey-weighted population statistics** computed by the\nproject's validated analytical engine (ATUS User's Guide ch. 7 estimators;\nreplicate-weight standard errors per ch. 7.5) \u2014 never unweighted sample\nmeans. 2020 has special weighting rules the engine enforces explicitly.\nMethodology: see docs/analytics.md and docs/methodology.md in the repository;\nthe engine reproduces 24 official BLS published values in its benchmark suite.\n\nResponses embed the exact canonical analysis `spec`; resubmitting it (same\n`analytics_version` and data release, see GET /api/v1/meta) reproduces the\nresult.\n",
  "version": "v1 (contract)"
 },
 "paths": {
  "/api/v1/analysis/estimate": {
   "post": {
    "tags": [
     "analysis"
    ],
    "summary": "Single (or pooled multi-year) estimate",
    "description": "Computes one survey-weighted estimate for the selected activity, population, and years, with an official replicate-weight standard error and confidence interval unless `variance` is `none`. Multi-year requests are pooled into one estimate (use the trend endpoint for per-year series). Estimates are weighted population statistics per ATUS User's Guide ch. 7 \u2014 never unweighted sample means.",
    "operationId": "estimate_api_v1_analysis_estimate_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/EstimateRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EstimateResponse"
        }
       }
      }
     },
     "400": {
      "description": "Malformed JSON body",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "422": {
      "description": "Schema violation, or analytically invalid/unsupported request (e.g. 2020 under the multiyear weight scheme)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "503": {
      "description": "Analytical database unavailable",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/analysis/trend": {
   "post": {
    "tags": [
     "analysis"
    ],
    "summary": "Per-year trend",
    "description": "Computes one estimate per requested year. Years that cannot be validly estimated under the requested weight scheme (2020 under `multiyear`) are returned as explicit unavailable points with a reason \u2014 never silently dropped, and never serialized as zero.",
    "operationId": "trend_api_v1_analysis_trend_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/TrendRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TrendResponse"
        }
       }
      }
     },
     "400": {
      "description": "Malformed JSON body",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "422": {
      "description": "Schema violation, or analytically invalid/unsupported request (e.g. 2020 under the multiyear weight scheme)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "503": {
      "description": "Analytical database unavailable",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/analysis/compare": {
   "post": {
    "tags": [
     "analysis"
    ],
    "summary": "Two-population comparison",
    "description": "Estimates the same measure for two populations (each group filter is merged onto the shared `population` filter) plus their difference (group_a \u2212 group_b). The difference's standard error is computed from per-replicate differences, which accounts for the covariance between the overlapping-sample group estimates.",
    "operationId": "compare_api_v1_analysis_compare_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CompareRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CompareResponse"
        }
       }
      }
     },
     "400": {
      "description": "Malformed JSON body",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "422": {
      "description": "Schema violation, or analytically invalid/unsupported request (e.g. 2020 under the multiyear weight scheme)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "503": {
      "description": "Analytical database unavailable",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/activities": {
   "get": {
    "tags": [
     "activities"
    ],
    "summary": "List/search the activity lexicon",
    "description": "Flat listing of the harmonized 2003-25 activity coding lexicon (18 major categories, 107 subcategories, 431 leaf activities), filterable by level, direct parent, and name search. In analysis requests, a 2- or 4-digit code selects itself plus all descendants.",
    "operationId": "list_activities_api_v1_activities_get",
    "parameters": [
     {
      "name": "level",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "maximum": 3,
         "minimum": 1
        },
        {
         "type": "null"
        }
       ],
       "title": "Level"
      }
     },
     {
      "name": "parent",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^[0-9]{2}([0-9]{2})?$"
        },
        {
         "type": "null"
        }
       ],
       "description": "Return direct children of this 2- or 4-digit code.",
       "title": "Parent"
      },
      "description": "Return direct children of this 2- or 4-digit code."
     },
     {
      "name": "search",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "minLength": 2,
         "maxLength": 80
        },
        {
         "type": "null"
        }
       ],
       "title": "Search"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ActivityListResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/activities/presets": {
   "get": {
    "tags": [
     "activities"
    ],
    "summary": "Named activity selections",
    "description": "Curated selections usable as {'preset': name} in analysis requests, including the BLS news-release table category definitions (verified against published Table A-1 values).",
    "operationId": "list_presets_api_v1_activities_presets_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ActivityPresetsResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/activities/{code}": {
   "get": {
    "tags": [
     "activities"
    ],
    "summary": "One lexicon code with its ancestry and children",
    "operationId": "activity_detail_api_v1_activities__code__get",
    "parameters": [
     {
      "name": "code",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Code"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ActivityDetailResponse"
        }
       }
      }
     },
     "404": {
      "description": "Unknown activity code",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/population/metadata": {
   "get": {
    "tags": [
     "population"
    ],
    "summary": "Supported population filter dimensions",
    "description": "Every population dimension analysis requests may filter on, with valid values for categorical dimensions. Served from the analytical engine's own dimension registry, so this vocabulary cannot drift from what filtering actually accepts.",
    "operationId": "population_metadata_api_v1_population_metadata_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PopulationMetadataResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/meta": {
   "get": {
    "tags": [
     "meta"
    ],
    "summary": "API, analytics, and data versions plus capability discovery",
    "description": "What this service can compute and against which data. `api_version` is the HTTP contract; `analytics_version` is the statistical implementation (a change means computed numbers may differ); `data` identifies the loaded BLS release and ingestion run. Clients should discover capabilities here instead of hard-coding them.",
    "operationId": "meta_api_v1_meta_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/MetaResponse"
        }
       }
      }
     }
    }
   }
  },
  "/health": {
   "get": {
    "tags": [
     "system"
    ],
    "summary": "Liveness",
    "description": "Answers whether the API process is running. No dependencies touched. Async on purpose: it bypasses the worker threadpool, so liveness stays instant even when every worker thread is busy with long analyses.",
    "operationId": "health_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Health Health Get"
        }
       }
      }
     }
    }
   }
  },
  "/ready": {
   "get": {
    "tags": [
     "system"
    ],
    "summary": "Readiness",
    "description": "Verifies the dependencies needed to answer analysis requests: the database is reachable and ATUS data is loaded. The (optional) result cache is not a readiness dependency \u2014 the service degrades gracefully without it. Readiness assumes the database passed `atus validate-db` at load time; it does not re-run data-quality checks.",
    "operationId": "ready_ready_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "503": {
      "description": "Not ready",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "ActivityDetailResponse": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "level": {
      "type": "integer",
      "title": "Level"
     },
     "parents": {
      "items": {
       "$ref": "#/components/schemas/ActivityEntry"
      },
      "type": "array",
      "title": "Parents",
      "description": "Ancestors, outermost first."
     },
     "children": {
      "items": {
       "$ref": "#/components/schemas/ActivityEntry"
      },
      "type": "array",
      "title": "Children",
      "description": "Direct children (empty for level 3)."
     },
     "harmonization_note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Harmonization Note"
     },
     "descendant_leaf_count": {
      "type": "integer",
      "title": "Descendant Leaf Count",
      "description": "Number of 6-digit codes selected when this code is used in an analysis (a tier code means itself plus all descendants)."
     }
    },
    "type": "object",
    "required": [
     "code",
     "name",
     "level",
     "parents",
     "children",
     "descendant_leaf_count"
    ],
    "title": "ActivityDetailResponse"
   },
   "ActivityEntry": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code",
      "description": "Harmonized 2003-25 lexicon code (2, 4, or 6 digits)."
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "level": {
      "type": "integer",
      "title": "Level",
      "description": "1 = major category, 2 = subcategory, 3 = 6-digit activity."
     },
     "parent_code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Parent Code",
      "description": "Immediate parent code (null for major categories)."
     },
     "harmonization_note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Harmonization Note",
      "description": "BLS note on retired codes this harmonized code absorbs (level 3 only)."
     }
    },
    "type": "object",
    "required": [
     "code",
     "name",
     "level"
    ],
    "title": "ActivityEntry"
   },
   "ActivityInfoModel": {
    "properties": {
     "label": {
      "type": "string",
      "title": "Label"
     },
     "include": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Include"
     },
     "exclude": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Exclude"
     },
     "leaf_code_count": {
      "type": "integer",
      "title": "Leaf Code Count",
      "description": "Number of 6-digit codes the selection resolves to."
     }
    },
    "type": "object",
    "required": [
     "label",
     "include",
     "exclude",
     "leaf_code_count"
    ],
    "title": "ActivityInfoModel"
   },
   "ActivityListResponse": {
    "properties": {
     "activities": {
      "items": {
       "$ref": "#/components/schemas/ActivityEntry"
      },
      "type": "array",
      "title": "Activities"
     },
     "total": {
      "type": "integer",
      "title": "Total",
      "description": "Entries returned after filters (the lexicon is small)."
     }
    },
    "type": "object",
    "required": [
     "activities",
     "total"
    ],
    "title": "ActivityListResponse",
    "examples": [
     {
      "activities": [
       {
        "code": "01",
        "level": 1,
        "name": "Personal Care Activities"
       },
       {
        "code": "0101",
        "level": 2,
        "name": "Sleeping",
        "parent_code": "01"
       },
       {
        "code": "010101",
        "level": 3,
        "name": "Sleeping",
        "parent_code": "0101"
       }
      ],
      "total": 3
     }
    ]
   },
   "ActivityPreset": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name",
      "description": "Value to use as {'preset': name} in analysis requests."
     },
     "label": {
      "type": "string",
      "title": "Label"
     },
     "include": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Include"
     },
     "exclude": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Exclude"
     }
    },
    "type": "object",
    "required": [
     "name",
     "label",
     "include",
     "exclude"
    ],
    "title": "ActivityPreset"
   },
   "ActivityPresetsResponse": {
    "properties": {
     "presets": {
      "items": {
       "$ref": "#/components/schemas/ActivityPreset"
      },
      "type": "array",
      "title": "Presets"
     }
    },
    "type": "object",
    "required": [
     "presets"
    ],
    "title": "ActivityPresetsResponse"
   },
   "ActivitySelection": {
    "properties": {
     "preset": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Preset",
      "description": "Named selection (see GET /api/v1/activities/presets)."
     },
     "include": {
      "anyOf": [
       {
        "items": {
         "type": "string",
         "pattern": "^[0-9]{2}([0-9]{2})?([0-9]{2})?$",
         "description": "2-, 4-, or 6-digit harmonized lexicon code"
        },
        "type": "array",
        "maxItems": 100
       },
       {
        "type": "null"
       }
      ],
      "title": "Include",
      "description": "Codes/tier prefixes to include."
     },
     "exclude": {
      "items": {
       "type": "string",
       "pattern": "^[0-9]{2}([0-9]{2})?([0-9]{2})?$",
       "description": "2-, 4-, or 6-digit harmonized lexicon code"
      },
      "type": "array",
      "maxItems": 100,
      "title": "Exclude",
      "description": "Codes/tier prefixes to exclude."
     },
     "label": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 120
       },
       {
        "type": "null"
       }
      ],
      "title": "Label"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "title": "ActivitySelection",
    "description": "Which activities to measure: a named preset, or explicit lexicon codes.\n\nA 2- or 4-digit code selects that tier and all of its descendants; an\nepisode matches when its 6-digit code falls under any `include` entry and\nunder no `exclude` entry. Codes are validated against the loaded lexicon."
   },
   "CapabilitiesInfo": {
    "properties": {
     "measures": {
      "items": {
       "$ref": "#/components/schemas/MeasureInfo"
      },
      "type": "array",
      "title": "Measures"
     },
     "weight_schemes": {
      "items": {
       "$ref": "#/components/schemas/WeightSchemeInfo"
      },
      "type": "array",
      "title": "Weight Schemes"
     },
     "variance_methods": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Variance Methods"
     },
     "confidence_level_default": {
      "type": "number",
      "title": "Confidence Level Default"
     },
     "activity_presets": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Activity Presets"
     },
     "population_dimensions": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Population Dimensions"
     },
     "limits": {
      "additionalProperties": true,
      "type": "object",
      "title": "Limits",
      "description": "Request limits (max years, max activity codes, ...)."
     },
     "unsupported": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Unsupported",
      "description": "Explicitly out-of-scope analysis types (do not infer support)."
     }
    },
    "type": "object",
    "required": [
     "measures",
     "weight_schemes",
     "variance_methods",
     "confidence_level_default",
     "activity_presets",
     "population_dimensions",
     "limits",
     "unsupported"
    ],
    "title": "CapabilitiesInfo"
   },
   "CompareRequest": {
    "properties": {
     "measure": {
      "type": "string",
      "enum": [
       "average_minutes_per_day",
       "participation_rate",
       "average_minutes_per_participant",
       "participants_per_day"
      ],
      "title": "Measure",
      "description": "ATUS User's Guide ch. 7.4 estimator (see GET /api/v1/meta).",
      "default": "average_minutes_per_day"
     },
     "activity": {
      "$ref": "#/components/schemas/ActivitySelection"
     },
     "years": {
      "items": {
       "type": "integer",
       "maximum": 2100.0,
       "minimum": 2003.0,
       "description": "ATUS survey year"
      },
      "type": "array",
      "maxItems": 50,
      "minItems": 1,
      "title": "Years",
      "description": "Survey years. Order-insensitive; duplicates are rejected."
     },
     "population": {
      "$ref": "#/components/schemas/PopulationRequest"
     },
     "weights": {
      "type": "string",
      "enum": [
       "multiyear",
       "pandemic"
      ],
      "title": "Weights",
      "description": "Weight scheme: 'multiyear' (TUFNWGTP; refuses 2020) or 'pandemic' (TU20FWGT; 2019/2020 only).",
      "default": "multiyear"
     },
     "variance": {
      "type": "string",
      "enum": [
       "replicate",
       "none"
      ],
      "title": "Variance",
      "description": "'replicate' = official 160-replicate-weight standard errors; 'none' = point estimate only (faster).",
      "default": "replicate"
     },
     "confidence_level": {
      "type": "number",
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.5,
      "title": "Confidence Level",
      "default": 0.95
     },
     "group_a": {
      "$ref": "#/components/schemas/PopulationRequest"
     },
     "group_b": {
      "$ref": "#/components/schemas/PopulationRequest"
     },
     "label_a": {
      "type": "string",
      "maxLength": 80,
      "title": "Label A",
      "default": "group_a"
     },
     "label_b": {
      "type": "string",
      "maxLength": 80,
      "title": "Label B",
      "default": "group_b"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "activity",
     "years",
     "group_a",
     "group_b"
    ],
    "title": "CompareRequest",
    "description": "Two populations, one measure. Group filters are merged onto the shared\n`population` filter; the difference's standard error is computed from\nper-replicate differences (covariance-correct).",
    "examples": [
     {
      "activity": {
       "preset": "household_activities_bls_table"
      },
      "group_a": {
       "sex": "male"
      },
      "group_b": {
       "sex": "female"
      },
      "label_a": "Men",
      "label_b": "Women",
      "measure": "average_minutes_per_day",
