# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/

# Environment and secrets (audit F31). Every .env variant in any directory
# (.env.local, .env.production, frontend/.env.production, ...) and every
# *.env file (secrets.env, edge.env, the smoke stack's env files) is ignored;
# only the committed templates are not. Real secrets live in provider secret
# stores and in ~/.config/atus/, never in the repository.
.env
.env.*
*.env
!.env.example
!.env.*.example
# wrangler's local secrets and state (edge/)
.dev.vars
.dev.vars.*
.wrangler/

# ATUS data: raw and staged files are large and are re-downloadable from BLS.
# Only the acquisition manifest and small committed reference data live in Git.
data/raw/
data/staging/
data/docs/
data/manifest.json

# Frontend (Phase 4)
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/test-results/
frontend/playwright-report/
frontend/node_modules/.tmp/

# OS noise
.DS_Store
.claude/
