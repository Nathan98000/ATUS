# Local production stack (docker-compose.prod.yml) settings.
#
#   cp deploy/stack/stack.env.example .env.stack     # .env.* is gitignored
#   # fill in every secret with a fresh random value, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   docker compose --env-file .env.stack -f docker-compose.prod.yml up -d --wait api
#
# scripts/smoke_stack.sh writes a throwaway file like this one (random values,
# mode 600, deleted on exit) so it never needs yours. These secrets protect a
# local stack only: never reuse a production value here, and never commit the
# filled-in copy. Values must be URL-safe (letters, digits, "-" and "_"):
# the DB passwords are embedded in connection URLs. The edge secret and the
# ops token need at least 32 characters: the API runs in production mode and
# refuses shorter ones at start-up.

# --- secrets (required) -------------------------------------------------------
# Bootstrap superuser `postgres` (initdb only; integration runs through PgBouncer).
ATUS_STACK_PG_SUPERUSER_PASSWORD=
# Owner role `neondb_owner`: loads the fixture or restores a dump.
ATUS_STACK_OWNER_PASSWORD=
# API role `atus_api`: SELECT only.
ATUS_STACK_API_DB_PASSWORD=
# Edge -> API shared secret: the API's ATUS_EDGE_SECRETS and the Worker's
# EDGE_AUTH_SECRET (one value; production accepts "current,next").
ATUS_STACK_EDGE_SECRET=
# Bearer for the API's /metrics and /ready (ATUS_OPS_TOKEN).
ATUS_STACK_OPS_TOKEN=
# Worker-only secrets (edge profile): bearer for /api/_ops/budget, IP HMAC key.
ATUS_STACK_EDGE_OPS_TOKEN=
ATUS_STACK_IP_HMAC_KEY=

# --- data -----------------------------------------------------------------------
# Default: the `seed` service loads the hand-computed fixture dataset.
# For a serving dump instead, set the path and add `--profile dump`.
# ATUS_STACK_DUMP=/absolute/path/to/atus-serving-<release>.dump
# The data_version the API must find (ADR-011 release switch); empty = no check.
ATUS_EXPECTED_DATA_VERSION=

# --- image ----------------------------------------------------------------------
# The API image the stack runs. Default: built from ./Dockerfile as
# atus-api:local. To run exactly what CI pushed, set the digest reference,
# ATUS_STACK_PULL_POLICY=missing, and start with `--no-build`, e.g.
# ATUS_STACK_IMAGE=ghcr.io/nathan98000/atus-api@sha256:<digest>.
# ATUS_STACK_IMAGE=atus-api:local
# ATUS_STACK_PULL_POLICY=build
# ATUS_BUILD_SHA=dev

# --- host ports (127.0.0.1 only; leave a value empty for a random free port) ----
# ATUS_STACK_DB_PORT=5470
# ATUS_STACK_PGBOUNCER_PORT=5471
# ATUS_STACK_EDGE_PORT=8541
